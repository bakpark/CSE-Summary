<mxfile host="app.diagrams.net" modified="2026-09-28T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="platform-architecture" name="1. 플랫폼 구조">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title1" value="Agentic Platform 구조" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#172B4D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="600" height="40" as="geometry"/></mxCell>
        <mxCell id="sub1" value="에이전트를 만들고 검증하는 과정과, 여러 채널에서 사용하는 과정을 하나의 플랫폼으로 연결" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#5E6C84;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="72" width="900" height="30" as="geometry"/></mxCell>

        <mxCell id="buildLane" value="만들기 및 검증" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#FFF7E6;swimlaneFillColor=#FFFFFF;strokeColor=#FFAB00;fontSize=17;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="1500" height="270" as="geometry"/></mxCell>
        <mxCell id="owner" value="&lt;b&gt;업무 담당자&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;업무 설명 · 실제 사례&lt;br&gt;완료 기준 · 승인 조건&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=16;spacing=10;" vertex="1" parent="buildLane"><mxGeometry x="35" y="85" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="ccab" value="&lt;b&gt;CCAB&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;에이전트 초안 생성 · 수정&lt;br&gt;업무 절차와 코드 작성&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontSize=16;spacing=10;" vertex="1" parent="buildLane"><mxGeometry x="310" y="85" width="235" height="105" as="geometry"/></mxCell>
        <mxCell id="stage" value="&lt;b&gt;Agent Stage Runner&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;에이전트 시험 환경&lt;br&gt;설치 · 실행 · 테스트&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#FFAB00;strokeWidth=2;fontSize=16;spacing=10;" vertex="1" parent="buildLane"><mxGeometry x="610" y="70" width="250" height="135" as="geometry"/></mxCell>
        <mxCell id="validate" value="&lt;b&gt;검증&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;실제 사례 테스트&lt;br&gt;권한 · 품질 확인&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=16;spacing=10;" vertex="1" parent="buildLane"><mxGeometry x="925" y="85" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="manage" value="&lt;b&gt;에이전트 관리&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;버전 · 배포 · 중지&lt;br&gt;변경 기록 · 되돌리기&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontSize=16;spacing=10;" vertex="1" parent="buildLane"><mxGeometry x="1200" y="70" width="255" height="135" as="geometry"/></mxCell>
        <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="buildLane" source="owner" target="ccab"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="buildLane" source="ccab" target="stage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="buildLane" source="stage" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#36B37E;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="buildLane" source="validate" target="manage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="retry" value="실패하면 수정 후 다시 검증" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#FF8B00;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#FF8B00;" edge="1" parent="buildLane" source="validate" target="ccab"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="230"/><mxPoint x="428" y="230"/></Array></mxGeometry></mxCell>

        <mxCell id="useLane" value="사용 및 실행" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#E6FCFF;swimlaneFillColor=#FFFFFF;strokeColor=#00B8D9;fontSize=17;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="1500" height="390" as="geometry"/></mxCell>
        <mxCell id="channels" value="&lt;b&gt;사용 채널&lt;/b&gt;&lt;br&gt;&lt;br&gt;KPAP (Web)&lt;br&gt;&lt;br&gt;Claude Desktop&lt;br&gt;&lt;br&gt;Slack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=16;spacing=12;align=left;" vertex="1" parent="useLane"><mxGeometry x="35" y="80" width="205" height="225" as="geometry"/></mxCell>
        <mxCell id="channelLink" value="&lt;b&gt;채널 연결&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;사용자 확인&lt;br&gt;요청 전달&lt;br&gt;결과 반환&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontSize=16;spacing=10;" vertex="1" parent="useLane"><mxGeometry x="305" y="115" width="210" height="155" as="geometry"/></mxCell>
        <mxCell id="runtime" value="&lt;b&gt;에이전트 실행 환경&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;배포된 에이전트 실행&lt;br&gt;진행 상태 · 재시도&lt;br&gt;사람의 확인 · 실행 기록&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontSize=16;spacing=10;" vertex="1" parent="useLane"><mxGeometry x="585" y="90" width="270" height="205" as="geometry"/></mxCell>
        <mxCell id="ops" value="&lt;b&gt;운영 관리&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;사용자·에이전트 권한&lt;br&gt;승인과 사용 한도&lt;br&gt;실행 이력과 품질 확인&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=16;spacing=10;" vertex="1" parent="useLane"><mxGeometry x="920" y="90" width="245" height="205" as="geometry"/></mxCell>
        <mxCell id="tools" value="&lt;b&gt;Tool Gateway&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;도구 연결·통제&lt;br&gt;API를 MCP로 제공&lt;br&gt;허용 도구와 접속 정보 보호&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#6B778C;strokeWidth=2;fontSize=16;spacing=10;" vertex="1" parent="useLane"><mxGeometry x="1230" y="90" width="240" height="205" as="geometry"/></mxCell>
        <mxCell id="u1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="useLane" source="channels" target="channelLink"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#00B8D9;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="useLane" source="channelLink" target="runtime"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="useLane" source="runtime" target="ops"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#00B8D9;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="useLane" source="ops" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="systems" value="&lt;b&gt;연결된 업무 시스템&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Jira · Confluence · Agit · Slack · Google Workspace · 사내 업무 API · 결제/혜택/송금 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#B3BAC5;fontSize=15;align=center;" vertex="1" parent="useLane"><mxGeometry x="305" y="325" width="1165" height="45" as="geometry"/></mxCell>
        <mxCell id="u5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="useLane" source="tools" target="systems"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="stageTool" value="시험과 운영에서 같은 도구 정의 사용" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#5E6C84;" edge="1" parent="1" source="stage" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="agent-lifecycle" name="2. Agent 정의와 운영 단계">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root><mxCell id="20"/><mxCell id="21" parent="20"/>
        <mxCell id="t2" value="Agent의 정의와 운영 단계" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#172B4D;align=left;" vertex="1" parent="21"><mxGeometry x="50" y="30" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="s2" value="Agent는 Prompt가 아니라, 반복 업무를 실행하기 위해 필요한 내용과 운영 기준을 함께 담은 단위" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#5E6C84;align=left;" vertex="1" parent="21"><mxGeometry x="50" y="72" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="defPanel" value="Agent에 포함되는 내용" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#DEEBFF;swimlaneFillColor=#FFFFFF;strokeColor=#4C9AFF;fontSize=17;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="21"><mxGeometry x="50" y="120" width="650" height="350" as="geometry"/></mxCell>
        <mxCell id="agentCenter" value="&lt;b&gt;업무 에이전트&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;호출 가능한 반복 업무&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;strokeWidth=2;fontSize=18;" vertex="1" parent="defPanel"><mxGeometry x="225" y="115" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="dGoal" value="&lt;b&gt;목표&lt;/b&gt;&lt;br&gt;완료·실패 기준" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=15;" vertex="1" parent="defPanel"><mxGeometry x="30" y="70" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="dIo" value="&lt;b&gt;입력과 결과&lt;/b&gt;&lt;br&gt;필요 정보·결과 형식" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=15;" vertex="1" parent="defPanel"><mxGeometry x="30" y="220" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="dFlow" value="&lt;b&gt;업무 절차&lt;/b&gt;&lt;br&gt;순서·판단·예외 처리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=15;" vertex="1" parent="defPanel"><mxGeometry x="465" y="60" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="dTool" value="&lt;b&gt;지식과 도구&lt;/b&gt;&lt;br&gt;자료·MCP·API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=15;" vertex="1" parent="defPanel"><mxGeometry x="465" y="145" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="dPolicy" value="&lt;b&gt;권한과 승인&lt;/b&gt;&lt;br&gt;범위·한도·사람 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=15;" vertex="1" parent="defPanel"><mxGeometry x="465" y="230" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="defLines" value="" style="shape=line;strokeColor=#B3BAC5;strokeWidth=2;" vertex="1" parent="defPanel"><mxGeometry x="185" y="170" width="280" height="1" as="geometry"/></mxCell>
        <mxCell id="three" value="&lt;b&gt;관리할 세 가지 기준&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. 업무 정의&lt;/b&gt; — 무엇을 하고 언제 끝나는가&lt;br&gt;&lt;br&gt;&lt;b&gt;2. 사용 범위&lt;/b&gt; — 어떤 자료와 도구를 누구의 권한으로 쓰는가&lt;br&gt;&lt;br&gt;&lt;b&gt;3. 검증 기록&lt;/b&gt; — 어떻게 시험했고 어떤 버전이 실행됐는가" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontSize=16;align=left;verticalAlign=top;spacing=24;" vertex="1" parent="21"><mxGeometry x="750" y="120" width="800" height="350" as="geometry"/></mxCell>

        <mxCell id="lifeTitle" value="운영 단계" style="text;html=1;strokeColor=none;fillColor=none;fontSize=19;fontStyle=1;fontColor=#172B4D;align=left;" vertex="1" parent="21"><mxGeometry x="50" y="510" width="300" height="35" as="geometry"/></mxCell>
        <mxCell id="l1" value="&lt;b&gt;업무 정리&lt;/b&gt;&lt;br&gt;사례·담당자" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=15;" vertex="1" parent="21"><mxGeometry x="50" y="590" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="l2" value="&lt;b&gt;초안&lt;/b&gt;&lt;br&gt;정의·코드·테스트" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=15;" vertex="1" parent="21"><mxGeometry x="260" y="590" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="l3" value="&lt;b&gt;실행 준비&lt;/b&gt;&lt;br&gt;설치·시험 실행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#FFAB00;fontSize=15;" vertex="1" parent="21"><mxGeometry x="470" y="590" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="l4" value="&lt;b&gt;검증&lt;/b&gt;&lt;br&gt;품질·권한 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontSize=15;" vertex="1" parent="21"><mxGeometry x="680" y="590" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="l5" value="&lt;b&gt;배포 버전&lt;/b&gt;&lt;br&gt;변경하지 않는 결과물" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=15;" vertex="1" parent="21"><mxGeometry x="890" y="590" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="l6" value="&lt;b&gt;운영 중&lt;/b&gt;&lt;br&gt;채널에서 반복 사용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontSize=15;" vertex="1" parent="21"><mxGeometry x="1100" y="590" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="l7" value="&lt;b&gt;관찰·개선&lt;/b&gt;&lt;br&gt;품질·비용·실패 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=15;" vertex="1" parent="21"><mxGeometry x="1310" y="590" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="21" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="21" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="21" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#36B37E;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="21" source="l4" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="21" source="l5" target="l6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="le6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6B778C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="21" source="l6" target="l7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="improve" value="변경할 때는 운영 중인 버전을 고치지 않고 새 초안으로 시작" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#FF8B00;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#FF8B00;" edge="1" parent="21" source="l7" target="l2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1405" y="750"/><mxPoint x="345" y="750"/></Array></mxGeometry></mxCell>
        <mxCell id="pause" value="중지 / 종료" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=14;" vertex="1" parent="21"><mxGeometry x="1100" y="735" width="170" height="50" as="geometry"/></mxCell><mxCell id="pauseEdge" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#FF5630;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="21" source="l6" target="pause"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="prompt-comparison" name="3. Prompt 방식과 비교">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root><mxCell id="30"/><mxCell id="31" parent="30"/>
        <mxCell id="t3" value="Prompt만 관리하는 방식과 실행 가능한 Agent의 차이" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#172B4D;align=left;" vertex="1" parent="31"><mxGeometry x="50" y="30" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="s3" value="차이는 Prompt의 길이가 아니라, 같은 조건으로 반복 실행하고 안전하게 운영할 수 있는가에 있음" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#5E6C84;align=left;" vertex="1" parent="31"><mxGeometry x="50" y="72" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="promptPanel" value="Prompt만 관리" style="swimlane;html=1;rounded=1;startSize=48;fillColor=#F4F5F7;swimlaneFillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=19;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="31"><mxGeometry x="50" y="130" width="610" height="650" as="geometry"/></mxCell>
        <mxCell id="prompt" value="“Jira와 Agit을 확인해서&lt;br&gt;이번 주 전사 주간보고를 작성해줘.”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#B3BAC5;fontSize=18;fontStyle=2;" vertex="1" parent="promptPanel"><mxGeometry x="45" y="85" width="520" height="110" as="geometry"/></mxCell>
        <mxCell id="p1" value="&lt;b&gt;실행 조건이 사용자마다 다름&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;모델·도구·자료 차이로 결과가 달라짐&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=16;align=left;spacing=12;" vertex="1" parent="promptPanel"><mxGeometry x="45" y="235" width="520" height="75" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;권한과 승인 기준이 Prompt 밖에 있음&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;도구와 데이터 범위를 강제로 제한하기 어려움&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=16;align=left;spacing=12;" vertex="1" parent="promptPanel"><mxGeometry x="45" y="330" width="520" height="75" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;운영 전 검증 기준이 없음&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;한 번의 성공과 반복 사용 가능성을 구분하기 어려움&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=16;align=left;spacing=12;" vertex="1" parent="promptPanel"><mxGeometry x="45" y="425" width="520" height="75" as="geometry"/></mxCell>
        <mxCell id="p4" value="&lt;b&gt;변경과 실패 이력이 개인에게 남음&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;버전·실행 결과·수정 이유를 함께 관리하기 어려움&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=16;align=left;spacing=12;" vertex="1" parent="promptPanel"><mxGeometry x="45" y="520" width="520" height="75" as="geometry"/></mxCell>

        <mxCell id="agentPanel" value="실행 가능한 Agent" style="swimlane;html=1;rounded=1;startSize=48;fillColor=#E3FCEF;swimlaneFillColor=#FFFFFF;strokeColor=#36B37E;strokeWidth=2;fontSize=19;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="31"><mxGeometry x="760" y="130" width="790" height="650" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;b&gt;업무 정의&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;목표 · 입력 · 결과 · 완료 기준 · 담당자&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontSize=16;align=left;spacing=12;" vertex="1" parent="agentPanel"><mxGeometry x="45" y="75" width="700" height="75" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;업무 절차&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;순서 · 판단 · 예외 처리 · 필요한 코드&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=16;align=left;spacing=12;" vertex="1" parent="agentPanel"><mxGeometry x="45" y="175" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;지식과 도구&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;MCP · API · 참고 자료 · 사용 범위&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=16;align=left;spacing=12;" vertex="1" parent="agentPanel"><mxGeometry x="415" y="175" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="a4" value="&lt;b&gt;실행 환경&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;설치 항목 · 사용 한도 · 진행 상태 · 재시도&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=16;align=left;spacing=12;" vertex="1" parent="agentPanel"><mxGeometry x="45" y="295" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="a5" value="&lt;b&gt;권한과 승인&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;사용자 권한 · 위험 기준 · 사람의 확인&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=16;align=left;spacing=12;" vertex="1" parent="agentPanel"><mxGeometry x="415" y="295" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="a6" value="&lt;b&gt;테스트와 검증&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;실제 사례 · 기대 결과 · 배포 전 확인&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=16;align=left;spacing=12;" vertex="1" parent="agentPanel"><mxGeometry x="45" y="415" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="a7" value="&lt;b&gt;버전과 실행 기록&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;배포 버전 · 변경 내역 · 실행 결과&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontSize=16;align=left;spacing=12;" vertex="1" parent="agentPanel"><mxGeometry x="415" y="415" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="channelRow" value="KPAP (Web)　　Claude Desktop　　Slack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontSize=16;" vertex="1" parent="agentPanel"><mxGeometry x="45" y="545" width="700" height="55" as="geometry"/></mxCell>
        <mxCell id="packArrow" value="함께 관리" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#36B37E;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontColor=#00875A;" edge="1" parent="31" source="promptPanel" target="agentPanel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bottom" value="같은 Agent를 여러 채널에서, 같은 권한과 품질 기준으로 사용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontSize=18;fontStyle=1;" vertex="1" parent="31"><mxGeometry x="300" y="820" width="1000" height="55" as="geometry"/></mxCell>
